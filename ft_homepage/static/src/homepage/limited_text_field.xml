<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <!-- web.TextField with `maxlength` on the textarea and a "n / max"
         counter under it. Inherited in `primary` mode so this is a NEW
         template: every other text field in the backend is untouched. -->
    <t t-name="ft_homepage.LimitedTextField" t-inherit="web.TextField"
       t-inherit-mode="primary">

        <xpath expr="//textarea" position="attributes">
            <attribute name="t-att-maxlength">props.maxLength</attribute>
            <attribute name="t-on-input">onInput</attribute>
        </xpath>

        <!-- Inside the wrapper div, so the counter sits directly under the
             textarea and moves with it as the box auto-resizes. -->
        <xpath expr="//div[@t-ref='div']" position="inside">
            <small class="ft_text_counter d-block text-end"
                   t-att-class="isFull ? 'text-danger fw-bold' : 'text-muted'">
                <t t-esc="counter.length"/> / <t t-esc="props.maxLength"/> characters
            </small>
        </xpath>

    </t>

</templates>
