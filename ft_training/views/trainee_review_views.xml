<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_trainee_review_list" model="ir.ui.view">
        <field name="name">ft.trainee.review.list</field>
        <field name="model">ft.trainee.review</field>
        <field name="arch" type="xml">
            <!-- Each score column is sized to its own header and nothing more.
                 The scores are left-aligned (see training_lists.css), so a
                 column wider than its label leaves the digit stranded far from
                 the next header and the eye stops pairing the two. Widths here
                 are the header text plus cell padding: enough that no label
                 wraps, tight enough that the value stays under it.

                 Description carries no width on purpose — it is the only
                 free-text column, so it absorbs whatever the fixed columns
                 leave instead of being boxed to a guess. Text renders truncated
                 to one line in a list, so row heights stay uniform and the
                 score columns keep reading straight down. -->
            <list string="Reviews" class="o_ft_review_list">
                <field name="trainee_id" width="160px"/>
                <field name="reviewer_id" width="150px"/>
                <field name="review_period" width="130px"/>
                <field name="attitude" width="90px"/>
                <field name="communication" width="125px"/>
                <field name="understanding" width="125px"/>
                <field name="technical" width="95px"/>
                <field name="problem_solving" width="130px"/>
                <field name="self_dependency" width="140px"/>
                <field name="create_date" string="Date" width="160px"/>
                <field name="description" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_trainee_review_form" model="ir.ui.view">
        <field name="name">ft.trainee.review.form</field>
        <field name="model">ft.trainee.review</field>
        <field name="arch" type="xml">
            <form string="Review">
                <sheet>
                    <notebook>
                        <page string="Review" name="review">
                            <group>
                                <group>
                                    <field name="trainee_id"
                                           options="{'no_create': True}"/>
                                    <field name="reviewer_id"
                                           options="{'no_create': True}"/>
                                    <field name="review_period"/>
                                    <field name="description"/>
                                </group>
                                <group string="Scores (0 - 10)">
                                    <field name="attitude"/>
                                    <field name="communication"/>
                                    <field name="understanding"/>
                                    <field name="technical"/>
                                    <field name="problem_solving"/>
                                    <field name="self_dependency"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_trainee_review_search" model="ir.ui.view">
        <field name="name">ft.trainee.review.search</field>
        <field name="model">ft.trainee.review</field>
        <field name="arch" type="xml">
            <search string="Reviews">
                <field name="trainee_id"/>
                <field name="reviewer_id"/>
                <field name="review_period"/>

                <filter name="my_reviews" string="My Reviews"
                        domain="[('reviewer_id', '=', uid)]"/>
                <separator/>
                <filter name="no_review_period" string="Review Period Not Set"
                        domain="[('review_period', '=', False)]"/>

                <group expand="0" string="Group By">
                    <filter name="group_trainee" string="Trainee"
                            context="{'group_by': 'trainee_id'}"/>
                    <filter name="group_reviewer" string="Reviewer"
                            context="{'group_by': 'reviewer_id'}"/>
                    <filter name="group_review_period" string="Review Period"
                            context="{'group_by': 'review_period'}"/>
                    <filter name="group_date" string="Date"
                            context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_trainee_review" model="ir.actions.act_window">
        <field name="name">Review</field>
        <field name="res_model">ft.trainee.review</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_trainee_review_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record a trainee review</p>
            <p>Pick a trainee and score them across the competencies (0 - 10).</p>
        </field>
    </record>

</odoo>
