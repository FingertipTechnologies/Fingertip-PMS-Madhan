<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ============================================= -->
        <!-- Project Dashboard -> moved inside PMS (Project) -->
        <!-- ============================================= -->
        <record id="ft_project_dashboard.menu_ft_project_dashboard_root" model="ir.ui.menu">
            <field name="name">Dashboard</field>
            <field name="parent_id" ref="project.menu_main_pm"/>
            <!-- Negative so "Dashboard" is first even in apps whose first
                 menu already sits at sequence 0 (e.g. CRM > Customers).
                 Odoo orders menus by "sequence, id". -->
            <field name="sequence">-1</field>
            <!-- Originally shipped groups="base.group_system" (Admin only)
                 in ft_project_dashboard — replaced here to match PMS's own
                 access (currently open to all internal users). -->
            <field name="groups_id" eval="[(6, 0, [ref('base.group_user')])]"/>
        </record>

        <!-- ============================================= -->
        <!-- Sales Dashboard -> moved inside CRM -->
        <!-- ============================================= -->
        <record id="ft_sales_dashboard.menu_sales_dashboard_in_dashboards" model="ir.ui.menu">
            <field name="name">Dashboard</field>
            <field name="parent_id" ref="crm.crm_menu_root"/>
            <!-- Negative so "Dashboard" is first even in apps whose first
                 menu already sits at sequence 0 (e.g. CRM > Customers).
                 Odoo orders menus by "sequence, id". -->
            <field name="sequence">-1</field>
            <!-- Originally shipped groups="base.group_system" (Admin only)
                 in ft_sales_dashboard — replaced here to match CRM's own
                 access (Sales team). -->
            <field name="groups_id" eval="[(6, 0, [ref('sales_team.group_sale_salesman')])]"/>
        </record>

        <!-- ============================================= -->
        <!-- Marketing Dashboard -> moved inside Marketing -->
        <!-- ============================================= -->
        <record id="ft_marketing_dashboard.menu_marketing_dashboard_in_dashboards" model="ir.ui.menu">
            <field name="name">Dashboard</field>
            <field name="parent_id" ref="marketing_content.menu_marketing_root"/>
            <!-- Negative so "Dashboard" is first even in apps whose first
                 menu already sits at sequence 0 (e.g. CRM > Customers).
                 Odoo orders menus by "sequence, id". -->
            <field name="sequence">-1</field>
            <!-- Originally shipped groups="base.group_system" (Admin only)
                 in ft_marketing_dashboard — replaced here to match
                 Marketing's own access (the "Marketing" role group). -->
            <field name="groups_id" eval="[(6, 0, [ref('Project_Scorecards.group_scorecard_marketing')])]"/>
        </record>

        <!-- ============================================= -->
        <!-- HR Dashboard -> moved inside General -->
        <!-- ============================================= -->
        <record id="ft_hr_dashboard.menu_hr_dashboard_in_dashboards" model="ir.ui.menu">
            <field name="name">Dashboard</field>
            <field name="parent_id" ref="general.menu_general_root"/>
            <!-- Negative so "Dashboard" is first even in apps whose first
                 menu already sits at sequence 0 (e.g. CRM > Customers).
                 Odoo orders menus by "sequence, id". -->
            <field name="sequence">-1</field>
            <!-- Administrators and HR only. This override is what actually
                 decides visibility: it loads after ft_hr_dashboard, so the
                 groups= on the menuitem there is replaced by whatever is set
                 here. Keep the two in step - ft_hr_dashboard declares the same
                 pair. hr.group_hr_manager is omitted because it implies
                 hr.group_hr_user. -->
            <field name="groups_id"
                   eval="[(6, 0, [ref('base.group_system'), ref('hr.group_hr_user')])]"/>
        </record>

        <!-- ============================================= -->
        <!-- Finance Dashboard -> moved inside Invoicing -->
        <!-- ============================================= -->
        <record id="ft_finance_dashboard.menu_finance_dashboard_in_dashboards" model="ir.ui.menu">
            <field name="name">Dashboard</field>
            <field name="parent_id" ref="account.menu_finance"/>
            <!-- Negative so "Dashboard" is first even in apps whose first
                 menu already sits at sequence 0 (e.g. CRM > Customers).
                 Odoo orders menus by "sequence, id". -->
            <field name="sequence">-1</field>
            <!-- Originally shipped groups="base.group_system" (Admin only)
                 in ft_finance_dashboard — replaced here to match
                 Invoicing's own access (Admin + Sales). -->
            <field name="groups_id" eval="[(6, 0, [
                ref('base.group_system'),
                ref('sales_team.group_sale_salesman'),
            ])]"/>
        </record>

    </data>
</odoo>
