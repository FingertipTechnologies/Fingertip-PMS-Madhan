<odoo>
    <!-- List View -->
    <record id="view_cus_campaign_list" model="ir.ui.view">
        <field name="name">cus.campaign.list</field>
        <field name="model">cus.campaign</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="source"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="amount" sum="Amount"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_cus_campaign_form" model="ir.ui.view">
        <field name="name">cus.campaign.form</field>
        <field name="model">cus.campaign</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Campaign Name"/>
                        <h1><field name="name" placeholder="e.g. Q3 LinkedIn Outreach"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="source"/>
                            <field name="amount"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_cus_campaign_search" model="ir.ui.view">
        <field name="name">cus.campaign.search</field>
        <field name="model">cus.campaign</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="source"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_source" string="Source"
                            context="{'group_by': 'source'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_cus_campaign" model="ir.actions.act_window">
        <field name="name">Campaigns</field>
        <field name="res_model">cus.campaign</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a campaign</p>
            <p>Track the campaigns your leads and opportunities come from,
               together with their budget and run dates.</p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_cus_campaign"
        action="action_cus_campaign"
        name="Campaigns"
        sequence="8"
        parent="crm.crm_menu_config"/>

</odoo>
